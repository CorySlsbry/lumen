# --- Database (Cloud SQL Postgres) ---
DATABASE_URL=postgresql://lumen:password@localhost:5432/lumen
# In Cloud Run, use the Cloud SQL Auth Proxy socket:
# DATABASE_URL=postgresql://lumen:password@/lumen?host=/cloudsql/PROJECT:REGION:INSTANCE

# --- Firebase Auth (client) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Plaid (sandbox) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx

# --- Claude (optional personalization touches) ---
ANTHROPIC_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
